<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.cuotafacil</groupId>
  <artifactId>cuotafacil</artifactId>
  <version>1.2.0</version>
  <name>cuotafacil</name>
  <description>Simulador de cuotas de préstamos personales (tasa preferente para clientes con haberes)</description>

  <properties>
    <!-- El parent lo traduce a maven.compiler.release=17: bytecode y API de Java 17 aunque se compile con un JDK más nuevo -->
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>cuotafacil</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <!-- Publica la versión en /actuator/info: QE la usa al ratificar el pase -->
            <goals>
              <goal>build-info</goal>
            </goals>
            <configuration>
              <!-- Sin build.time: con builds reproducibles saldría una fecha de 1980 que confunde al ratificar -->
              <time>off</time>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
